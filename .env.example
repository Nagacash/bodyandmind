# Resend – contact & booking form emails
RESEND_API_KEY=

# --- Testing (before domain is verified) ---
# Resend test sender; can only deliver to YOUR Resend account email:
# RESEND_FROM_EMAIL=onboarding@resend.dev
# INQUIRY_TO_EMAIL=your-resend-account@gmail.com

# --- Production (after verifying domain at https://resend.com/domains) ---
RESEND_FROM_EMAIL="body & mind <info@nataliezimmermann.de>"
INQUIRY_TO_EMAIL=info@nataliezimmermann.de

# API server port (default 3001)
PORT=3001

# Optional: comma-separated extra allowed CORS origins (merged with production defaults)
# ALLOWED_ORIGINS=https://staging.example.com
